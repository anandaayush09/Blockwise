# Copy to .env (gitignored). Never commit real values.
# Placeholders only.

ENVIRONMENT=local                      # local | staging | production
LOG_LEVEL=INFO

# LLM (ADR-0010)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5-5
LLM_BUDGET_INR_PER_RUN=               # hard cap per plan run; decide in ADR-0010

# Infra (ADR-0011, ADR-0012)
DATABASE_URL=postgresql+psycopg://blockwise:change-me@postgres:5432/blockwise
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=change-me

# Observability (ADR-0013)
SENTRY_DSN=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Data sources (ADR-0002) - fill when you choose them
IEX_DATA_SOURCE=
WEATHER_API_BASE=https://api.open-meteo.com/v1
